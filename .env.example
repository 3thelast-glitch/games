# Server runtime, Node 24+. Copy to .env and replace example origins before deployment.
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=data/board-arena.db
MATCH_CLOCK_MS=600000
RECONNECT_GRACE_MS=60000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787,https://localhost,capacitor://localhost

# Production URLs: HTTPS origins without trailing slashes.
# PUBLIC_SERVER_URL=https://arena.example.com
# APP_URL=https://arena.example.com
# VITE_SERVER_URL=https://arena.example.com
# VITE_SERVER_URL is compiled into the app; rebuild after changing it.
# Leave it empty for the same-origin web app / Vite proxy.

# Optional Google OAuth web client. Callback: PUBLIC_SERVER_URL/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Apple Services ID and signed client-secret JWT.
# Callback: PUBLIC_SERVER_URL/api/auth/oauth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
